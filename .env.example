# TrueLine environment configuration
#
# Every domain below is driven by a provider trio: live / replay / mock.
# For every *_MODE var: valid values are "live" | "replay" | "mock".
# Leaving a *_MODE var unset does NOT necessarily mean "mock" — most
# domains default to "live" (a few fall back to a related domain's mode
# first, then to "live"). See src/services/*Service.ts for the exact
# per-domain fallback chain if you need to trace one precisely.
#
# Nothing in this file is a real secret. Copy this file to `.env.local`
# and fill in real values there — `.env.local` is gitignored.

# ---------------------------------------------------------------------------
# Admin auth (src/auth/, proxy.ts, app/admin/)
# ---------------------------------------------------------------------------
# Protects /admin/* (backtesting, calibration, odds-intelligence dashboards)
# behind a single shared password — there are no user accounts yet, just an
# admin gate. Without both vars set, /admin/* is unreachable (fails closed,
# not open): logins can never succeed and sessions can never validate.
ADMIN_PASSWORD=
# Signs the admin session cookie (HMAC-SHA256). Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Persistence (src/persistence/)
# ---------------------------------------------------------------------------
# Any standard Postgres connection string works — Neon, Supabase, Vercel
# Postgres, or a local instance. Required to use src/persistence/* at all;
# repositories throw immediately if this is unset. Run migrations with
# `npx drizzle-kit generate` (schema change -> SQL file under drizzle/)
# and `npx drizzle-kit migrate` (apply pending migrations).
#
# Also backs PostgresCacheProvider (src/cache/PostgresCacheProvider.ts) -
# an opt-in CacheProvider that survives restarts, unlike the default
# MemoryCache. Not wired in as any service's default yet; swap it in
# explicitly per service if you want durable caching there.
DATABASE_URL=postgresql://user:password@localhost:5432/trueline

# ---------------------------------------------------------------------------
# Odds (OddsPipe)
# ---------------------------------------------------------------------------
# Default mode: live. Live mode throws if ODDSPIPE_API_KEY is missing.
ODDS_MODE=mock
ODDSPIPE_API_KEY=
ODDSPIPE_API_URL=https://api.oddspipe.com/v1/odds
# Set to "true" to record raw live responses into replay/odds/ for later replay.
ODDS_RECORD=false
ODDS_REPLAY_DIR=replay/odds
ODDS_REPLAY_FILE=

# ---------------------------------------------------------------------------
# Weather (Open-Meteo)
# ---------------------------------------------------------------------------
# Default mode: live. Open-Meteo's free tier does not require a key; only
# set OPEN_METEO_API_KEY if you're using a paid/commercial Open-Meteo plan.
WEATHER_MODE=mock
OPEN_METEO_API_KEY=
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_RECORD=false
WEATHER_REPLAY_DIR=replay/weather
WEATHER_REPLAY_FILE=

# ---------------------------------------------------------------------------
# Ballparks (MLB venues + Baseball Savant park factors)
# ---------------------------------------------------------------------------
# Default mode: live, falling back to WEATHER_MODE if that's replay/mock.
BALLPARK_MODE=mock
BASEBALL_SAVANT_PARK_FACTORS_URL=
BALLPARK_RECORD=false
BALLPARK_REPLAY_DIR=replay/ballparks
BALLPARK_REPLAY_FILE=

# ---------------------------------------------------------------------------
# Bullpen quality
# ---------------------------------------------------------------------------
# Default mode: live, falling back to TEAM_STRENGTH_MODE if that's replay/mock.
BULLPEN_MODE=mock
BULLPEN_RECORD=false
BULLPEN_REPLAY_DIR=replay/bullpen
BULLPEN_REPLAY_FILE=

# ---------------------------------------------------------------------------
# Lineups (confirmed / projected)
# ---------------------------------------------------------------------------
# Default mode: live, falling back to BULLPEN_MODE then TEAM_STRENGTH_MODE.
LINEUP_MODE=mock
LINEUP_RECORD=false
LINEUP_REPLAY_DIR=replay/lineups
LINEUP_REPLAY_FILE=

# ---------------------------------------------------------------------------
# Pitcher season stats
# ---------------------------------------------------------------------------
# Default mode: live, falling back to ODDS_MODE if that's replay/mock.
PITCHER_MODE=mock
PITCHER_RECORD=false
PITCHER_REPLAY_DIR=replay/pitchers
PITCHER_REPLAY_FILE=

# ---------------------------------------------------------------------------
# Team strength (offense/pitching season stats)
# ---------------------------------------------------------------------------
# Default mode: live, falling back to PITCHER_MODE then ODDS_MODE.
TEAM_STRENGTH_MODE=mock
TEAM_STRENGTH_RECORD=false
TEAM_STRENGTH_REPLAY_DIR=replay/team-strength
TEAM_STRENGTH_REPLAY_FILE=

# ---------------------------------------------------------------------------
# Recent form (rolling 7/14/30-game windows)
# ---------------------------------------------------------------------------
# Default mode: live, falling back to TEAM_STRENGTH_MODE then PITCHER_MODE.
RECENT_FORM_MODE=mock
RECENT_FORM_RECORD=false
RECENT_FORM_REPLAY_DIR=replay/recent-form
RECENT_FORM_REPLAY_FILE=

# ---------------------------------------------------------------------------
# Player intelligence (pitcher/batter game logs)
# ---------------------------------------------------------------------------
# Default mode: live, falling back to PITCHER_MODE if that's replay/mock.
# PITCHER_GAME_LOG_MODE is an alias checked before PLAYER_INTELLIGENCE_MODE.
PLAYER_INTELLIGENCE_MODE=mock
PITCHER_GAME_LOG_MODE=
PLAYER_INTELLIGENCE_RECORD=false
PLAYER_INTELLIGENCE_REPLAY_DIR=replay/player-intelligence
PLAYER_INTELLIGENCE_REPLAY_FILE=
BATTER_INTELLIGENCE_REPLAY_DIR=replay/player-intelligence/batters
BATTER_INTELLIGENCE_REPLAY_FILE=

# ---------------------------------------------------------------------------
# Matchup intelligence (Statcast pitch/zone data)
# ---------------------------------------------------------------------------
# Default mode: live.
MATCHUP_MODE=mock
STATCAST_CSV_URL=https://baseballsavant.mlb.com/statcast_search/csv
MATCHUP_RECORD=false
MATCHUP_REPLAY_DIR=replay/matchup
MATCHUP_REPLAY_FILE=

# ---------------------------------------------------------------------------
# Ranking engine
# ---------------------------------------------------------------------------
# Default mode: live.
RANKING_MODE=mock
RANKING_REPLAY_FILE=

# ---------------------------------------------------------------------------
# Calibration engine (admin)
# ---------------------------------------------------------------------------
# Default mode: mock. Set to "live" to read real recorded predictions/
# results from Postgres (DurableCalibrationProvider) instead of fixtures -
# currently only meaningful for the moneyline market (see MASTER_CHECKLIST.md).
CALIBRATION_MODE=mock
CALIBRATION_REPLAY_FILE=

# ---------------------------------------------------------------------------
# Backtesting engine (admin)
# ---------------------------------------------------------------------------
# Default mode: mock. Set to "live" to read real recorded predictions/
# results from Postgres, grouped into daily slates (DurableHistoricalSlateProvider)
# - currently only meaningful for the moneyline market, same as calibration.
BACKTEST_MODE=mock
BACKTEST_REPLAY_FILE=

# ---------------------------------------------------------------------------
# Odds intelligence (admin — CLV / line movement)
# ---------------------------------------------------------------------------
# Default mode: mock. Set to "live" to read real per-game moneyline
# snapshots + predictions from Postgres (DurableOddsIntelligenceProvider) -
# opening-to-current movement is real; closing-line-value (CLV) is not
# yet, since a genuine "closing" line needs to know a game has actually
# started/finished, which isn't tracked. Moneyline only.
ODDS_INTELLIGENCE_MODE=mock
ODDS_INTELLIGENCE_REPLAY_FILE=

# ---------------------------------------------------------------------------
# Game results ingestion (src/providers/game-results/, src/services/GameResultsService.ts)
# ---------------------------------------------------------------------------
# Default mode: live. Fetches completed games + final scores from the MLB
# Stats API schedule endpoint (MLB_API_URL below) and durably records them
# to game_results via ingestGameResults() - not wired to any automatic
# trigger yet (no cron/scheduled-job infra exists in this app), so it must
# be invoked manually or from a future admin/cron action. No replay
# provider exists yet; "replay" currently falls back to the live provider.
GAME_RESULTS_MODE=mock

# ---------------------------------------------------------------------------
# Injuries (src/providers/injuries/, src/services/InjuriesService.ts)
# ---------------------------------------------------------------------------
# Default mode: live. Fetches recent Injured List transactions from the MLB
# Stats API transactions endpoint (MLB_API_URL below). Only produces
# "10-day IL" / "15-day IL" statuses - "Probable"/"Questionable"/"Day-to-day"
# need a different (lineup-card) data source, out of scope here.
# impactRating always defaults to a neutral 50 - real impact scoring needs
# player-performance context this feed doesn't provide. No replay provider
# exists yet; "replay" currently falls back to the live provider. On a live
# fetch failure this degrades to an empty list, not mock data.
INJURIES_MODE=mock

# ---------------------------------------------------------------------------
# MLB Stats API base URLs (shared across several live providers above)
# ---------------------------------------------------------------------------
MLB_API_URL=https://statsapi.mlb.com/api/v1
MLB_STATS_API_URL=https://statsapi.mlb.com/api/v1/stats
MLB_TEAMS_API_URL=https://statsapi.mlb.com/api/v1/teams
MLB_PEOPLE_API_URL=https://statsapi.mlb.com/api/v1/people
